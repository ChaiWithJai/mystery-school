{
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "premise", "story", "surprise", "question", "choices", "assumptions", "visual", "evidence", "experiment"],
  "properties": {
    "experiment": {"anyOf": [{"type": "null"}, {
      "type": "object", "additionalProperties": false,
      "required": ["version", "pathway", "base_artifact_id", "status", "reason", "music", "movement", "ideas"],
      "properties": {
        "version": {"type": "integer", "enum": [1]},
        "pathway": {"type": "string", "enum": ["music", "movement", "ideas"]},
        "base_artifact_id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["supported", "unsupported"]},
        "reason": {"type": "string", "minLength": 1},
        "music": {"anyOf": [{"type": "null"}, {
          "type": "object", "additionalProperties": false, "required": ["attack", "notes", "tempo"],
          "properties": {
            "attack": {"type": "number", "minimum": 0.02, "maximum": 0.8},
            "tempo": {"type": "integer", "minimum": 40, "maximum": 180},
            "notes": {"type": "array", "minItems": 2, "maxItems": 16, "items": {
              "type": "object", "additionalProperties": false, "required": ["midi", "beats"],
              "properties": {"midi": {"type": "integer", "minimum": 48, "maximum": 84}, "beats": {"type": "number", "minimum": 0.25, "maximum": 4}}
            }}
          }
        }]},
        "movement": {"anyOf": [{"type": "null"}, {
          "type": "object", "additionalProperties": false, "required": ["duration", "distance", "shape", "compare_shape", "view", "boxing_params"],
          "properties": {
            "boxing_params": {"anyOf": [{"type": "null"}, {
              "type": "object", "additionalProperties": false, "required": ["cue", "gap"],
              "properties": {"cue": {"type": "number", "minimum": 0.65, "maximum": 1.65}, "gap": {"type": "number", "minimum": 10, "maximum": 22}}
            }]},
            "duration": {"type": "number", "minimum": 1, "maximum": 4},
            "distance": {"type": "number", "minimum": 0.1, "maximum": 1},
            "shape": {"type": "string", "enum": ["cubic", "quintic"]},
            "compare_shape": {"type": "string", "enum": ["cubic", "quintic"]},
            "view": {"type": "string", "enum": ["position", "velocity", "acceleration"]}
          }
        }]},
        "ideas": {"anyOf": [{"type": "null"}, {
          "type": "object", "additionalProperties": false, "required": ["scenario", "question", "source_quote", "source_ref_index"],
          "properties": {"scenario": {"type": "string", "minLength": 1}, "question": {"type": "string", "minLength": 1}, "source_quote": {"type": "string", "minLength": 1}, "source_ref_index": {"type": "integer", "minimum": 0}}
        }]}
      }
    }]},
    "title": {"type": "string"},
    "premise": {"type": "string"},
    "story": {"type": "string"},
    "surprise": {"type": "string"},
    "question": {"type": "string"},
    "choices": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["label", "consequence"], "properties": {"label": {"type": "string"}, "consequence": {"type": "string"}}}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "visual": {"type": "object", "additionalProperties": false, "required": ["tree_density", "connection_strength", "light", "openness"], "properties": {"tree_density": {"type": "number", "minimum": 0, "maximum": 1}, "connection_strength": {"type": "number", "minimum": 0, "maximum": 1}, "light": {"type": "number", "minimum": 0, "maximum": 1}, "openness": {"type": "number", "minimum": 0, "maximum": 1}}},
    "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["label", "basis", "detail"], "properties": {"label": {"type": "string"}, "basis": {"type": "string", "enum": ["user_statement", "reference_observation", "imagined"]}, "detail": {"type": "string"}}}}
  }
}
