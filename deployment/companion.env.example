# Copy into your launch environment. Never commit real values.
MYSTERY_COMPANION_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_TOKEN
MYSTERY_SCHOOL_URL=http://127.0.0.1:5188
# Set the token above in the school server environment too for local /api/coach.
MYSTERY_COMPANION_LOCAL_URL=http://127.0.0.1:5199
MYSTERY_BONSAI_URL=http://127.0.0.1:8080
MYSTERY_COMPANION_DATA=data/companion
# Optional: shared local MLflow store; otherwise companion creates its own.
# MYSTERY_COACH_TRACKING_URI=sqlite:////absolute/path/to/mlflow.db
# Netlify Functions only (do not expose in browser build variables):
# MYSTERY_COMPANION_URL=https://your-authenticated-companion-tunnel.example
# MYSTERY_DEMO_CODE=SEPARATE_RANDOM_32_BYTE_CODE
# MYSTERY_SESSION_SECRET=SEPARATE_RANDOM_32_BYTE_SECRET
